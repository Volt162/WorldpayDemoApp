<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0-android;net8.0-ios</TargetFrameworks>

		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">11.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net8.0-ios|AnyCPU'">
	  <CreatePackage>false</CreatePackage>
	  <MtouchExtraArgs>-gcc_flags "-ObjC"</MtouchExtraArgs>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0-ios'">
	  <ProjectReference Include="..\..\PSBindingLibrary\PSBindingLibrary\PSBindingLibrary.csproj" />
	</ItemGroup>
	<ItemGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net8.0-ios|AnyCPU'">
	  <Reference Include="PSBindingLibrary">
	    <HintPath>..\..\PSBindingLibrary\PSBindingLibrary\bin\Debug\net8.0-ios\PSBindingLibrary.dll</HintPath>
	  </Reference>
	</ItemGroup>
<!--	<ItemGroup>
	  <None Remove="Platforms\iOS\Services\" />
	  <None Remove="Platforms\Android\Services\" />
	</ItemGroup>-->
	<ItemGroup>
	  <Folder Include="Platforms\iOS\Services\" />
	  <Folder Include="Platforms\Android\Services\" />
	  <Folder Include="Platforms\Android\Utils\" />
	  <Folder Include="Models\" />
	  <Folder Include="Platforms\iOS\Utils\" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0-android'">
	  <ProjectReference Include="..\..\PsBindingLibrary.Android\PsBindingLibrary.Android\PsBindingLibrary.Android.csproj" />
	  <PackageReference Include="Xamarin.Google.Guava.ListenableFuture" Version="1.0.0.23" ExcludeAssets="All" JavaArtifact="com.google.guava:listenablefuture" JavaVersion="9999.0-empty-to-avoid-conflict-with-guava" />
	</ItemGroup>
	<ItemGroup>
	  <None Remove="Platforms\Android\Utils\" />
	  <None Remove="Models\" />
	  <None Remove="Platforms\iOS\Utils\" />
	</ItemGroup>
</Project>
